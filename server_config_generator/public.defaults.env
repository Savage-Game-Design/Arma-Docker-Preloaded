# Common Arma 3 settings for public servers

# ---- SERVER IDENTITY AND ACCESS ----
# headlessClients  (string list, engine default: {})
ARMA_CFG_HEADLESS_CLIENTS=127.0.0.1
# localClient  (string list, engine default: {})
ARMA_CFG_LOCAL_CLIENT=127.0.0.1

# ---- MESSAGE OF THE DAY ----
# motdInterval  (number, engine default: 5)
ARMA_CFG_MOTD_INTERVAL=5

# ---- SECURITY ----
# BattlEye  (flag, engine default: 1)
ARMA_CFG_BATTLEYE=1
# verifySignatures  (number, engine default: 2)
ARMA_CFG_VERIFY_SIGNATURES=2
# allowedLoadFileExtensions  (string list, engine default: undefined (everything allowed))
ARMA_CFG_ALLOWED_LOAD_FILE_EXTENSIONS=hpp|sqs|sqf|fsm|cpp|paa|txt|xml|inc|ext|sqm|ods|fxy|lip|csv|kb|bik|bikb|html|htm|biedi
# allowedPreprocessFileExtensions  (string list, engine default: undefined (everything allowed))
ARMA_CFG_ALLOWED_PREPROCESS_FILE_EXTENSIONS=hpp|sqs|sqf|fsm|cpp|paa|txt|xml|inc|ext|sqm|ods|fxy|lip|csv|kb|bik|bikb|html|htm|biedi

# ---- VOTING ----
# voteThreshold  (number, engine default: 0.5)
ARMA_CFG_VOTE_THRESHOLD=0.7
# voteMissionPlayers  (number, engine default: 1)
ARMA_CFG_VOTE_MISSION_PLAYERS=1

# ---- NETWORK QUALITY ----
# maxPing  (number, engine default: -1)
ARMA_CFG_MAX_PING=999
# maxPacketLoss  (number, engine default: -1)
ARMA_CFG_MAX_PACKET_LOSS=51
# maxDesync  (number, engine default: -1)
ARMA_CFG_MAX_DESYNC=9999
# disconnectTimeout  (number, engine default: 15)
ARMA_CFG_DISCONNECT_TIMEOUT=10
# kickClientsOnSlowNetwork  (number list, engine default: { 1, 1, 1, 1 })
ARMA_CFG_KICK_CLIENTS_ON_SLOW_NETWORK=1|1|0|1
# enablePlayerDiag  (flag, engine default: 0)
ARMA_CFG_ENABLE_PLAYER_DIAG=0
# steamProtocolMaxDataSize  (number, engine default: 1024)
ARMA_CFG_STEAM_PROTOCOL_MAX_DATA_SIZE=1400

# ---- KICKS AND TIMEOUTS ----
# kickTimeout  (rows, engine default: { { 0, 60 }, { 1, 60 }, { 2, 60 }, { 3, 60 } })
ARMA_CFG_KICK_TIMEOUT=0,-2|1,180|2,180|3,15

# ---- MISSION CYCLE ----
# autoSelectMission  (bool, engine default: false)
ARMA_CFG_AUTO_SELECT_MISSION=true
# persistent  (flag, engine default: 0)
ARMA_CFG_PERSISTENT=0

# ---- IN-GAME ----
# disableVoN  (flag, engine default: 0)
ARMA_CFG_DISABLE_VON=1
# vonCodecQuality  (number, engine default: 3)
ARMA_CFG_VON_CODEC_QUALITY=30
# disableChannels  (rows, engine default: {})
ARMA_CFG_DISABLE_CHANNELS=0,true,true|1,true,false|2,false,false|3,false,false|4,false,false|5,false,false|6,true,false

# ---- LOGGING AND ANALYTICS ----
# logFile  (string, engine default: "")
ARMA_CFG_LOG_FILE=server_console.log
# timeStampFormat  (string, engine default: "short")
ARMA_CFG_TIME_STAMP_FORMAT=short
# statisticsEnabled  (flag, engine default: 1)
ARMA_CFG_STATISTICS_ENABLED=1

# ---- SERVER-SIDE SCRIPTING EVENT HANDLERS ----
# doubleIdDetected  (string, engine default: "")
ARMA_CFG_DOUBLE_ID_DETECTED=
# onUserConnected  (string, engine default: "")
ARMA_CFG_ON_USER_CONNECTED=
# onUserDisconnected  (string, engine default: "")
ARMA_CFG_ON_USER_DISCONNECTED=
# onHackedData  (string, engine default: "")
ARMA_CFG_ON_HACKED_DATA=
# onDifferentData  (string, engine default: "")
ARMA_CFG_ON_DIFFERENT_DATA=
# onUnsignedData  (string, engine default: "")
ARMA_CFG_ON_UNSIGNED_DATA=

# ---- class AdvancedOptions ----
# logObjectNotFound  (flag, engine default: 1)
ARMA_CFG_ADVANCED_OPTIONS_LOG_OBJECT_NOT_FOUND=0
# skipDescriptionParsing  (flag, engine default: 0)
ARMA_CFG_ADVANCED_OPTIONS_SKIP_DESCRIPTION_PARSING=0
# ignoreMissionLoadErrors  (flag, engine default: 0)
ARMA_CFG_ADVANCED_OPTIONS_IGNORE_MISSION_LOAD_ERRORS=0

# ---- MISSIONS ----
# Indexed from 1, contiguous. TEMPLATE and DIFFICULTY are required per mission.
# PARAMS values are emitted as written: wrap in "..." for a string parameter.
ARMA_CFG_MISSION_1_DIFFICULTY=Custom

# ==== DIFFICULTY (profile) ====
# Rendered into class CustomDifficulty of <name>.Arma3Profile. Missions must use difficulty = "Custom".

# ---- DIFFICULTY OPTIONS (profile) ----
# reducedDamage  (number, values: 0 or 1)
ARMA_DIFFICULTY_REDUCED_DAMAGE=0
# groupIndicators  (number, values: 0 never, 1 limited distance, 2 always)
ARMA_DIFFICULTY_GROUP_INDICATORS=0
# friendlyTags  (number, values: 0 never, 1 limited distance, 2 always)
ARMA_DIFFICULTY_FRIENDLY_TAGS=1
# enemyTags  (number, values: 0 never, 1 limited distance, 2 always)
ARMA_DIFFICULTY_ENEMY_TAGS=0
# detectedMines  (number, values: 0 never, 1 limited distance, 2 always)
ARMA_DIFFICULTY_DETECTED_MINES=1
# commands  (number, values: 0 never, 1 fade out, 2 always)
ARMA_DIFFICULTY_COMMANDS=0
# waypoints  (number, values: 0 never, 1 fade out, 2 always)
ARMA_DIFFICULTY_WAYPOINTS=0
# weaponInfo  (number, values: 0 never, 1 fade out, 2 always)
ARMA_DIFFICULTY_WEAPON_INFO=2
# stanceIndicator  (number, values: 0 never, 1 fade out, 2 always)
ARMA_DIFFICULTY_STANCE_INDICATOR=2
# staminaBar  (number, values: 0 or 1)
ARMA_DIFFICULTY_STAMINA_BAR=1
# weaponCrosshair  (number, values: 0 or 1)
ARMA_DIFFICULTY_WEAPON_CROSSHAIR=0
# visionAid  (number, values: 0 or 1)
ARMA_DIFFICULTY_VISION_AID=0
# thirdPersonView  (number, values: 0 off, 1 on, 2 vehicles only)
ARMA_DIFFICULTY_THIRD_PERSON_VIEW=1
# cameraShake  (number, values: 0 or 1)
ARMA_DIFFICULTY_CAMERA_SHAKE=1
# scoreTable  (number, values: 0 or 1)
ARMA_DIFFICULTY_SCORE_TABLE=1
# deathMessages  (number, values: 0 or 1)
ARMA_DIFFICULTY_DEATH_MESSAGES=0
# vonID  (number, values: 0 or 1)
ARMA_DIFFICULTY_VON_ID=1
# mapContent  (number, values: 0 or 1)
ARMA_DIFFICULTY_MAP_CONTENT=0
# autoReport  (number, values: 0 or 1)
ARMA_DIFFICULTY_AUTO_REPORT=0
# multipleSaves  (number, values: 0 or 1)
ARMA_DIFFICULTY_MULTIPLE_SAVES=0

# ---- DIFFICULTY AI (profile) ----
# aiLevelPreset  (number, values: 0 low, 1 normal, 2 high, 3 custom)
ARMA_DIFFICULTY_AI_LEVEL_PRESET=1
