# Defaults for the generated Arma 3 server.cfg and profile difficulty.
#
# Same format as the environment: ARMA_CFG_<NAME>=<value> or ARMA_DIFFICULTY_<NAME>=<value>,
# one per line. Environment variables override anything set here.
#
# A line left commented out means the key is omitted and Arma uses its built-in behaviour.
# The engine default shown beside each ARMA_CFG_ entry is documented at
# https://community.bistudio.com/wiki/Arma_3:_Server_Config_File and is for reference only.
#
# ARMA_DIFFICULTY_* entries render class CustomDifficulty in <name>.Arma3Profile, where <name>
# comes from the -name= startup argument. The profile is written only when at least one is set,
# and a mission must use difficulty = "Custom" for it to apply.
#
# Value formats:
#   number       integer or decimal, e.g. 24 or 0.7
#   flag         0 or 1
#   bool         true or false
#   string list  item|item|item
#   rows         field,field|field,field
#   timeout      60  or  60|90  (ready|notReady)
#   Any list also accepts a JSON array, e.g. ["a","b"] or [[0,-1],[1,20]].
#   An empty value emits "" or {}. The value null omits the key.
#   Any variable may be given as <VARIABLE>_FILE=/path to read the value from a file.

# ---- SERVER IDENTITY AND ACCESS ----
# hostname  (string, engine default: local machine name)
#ARMA_CFG_HOSTNAME=
# password  (string, engine default: "")
#ARMA_CFG_PASSWORD=
# passwordAdmin  (string, engine default: "")
#ARMA_CFG_PASSWORD_ADMIN=
# serverCommandPassword  (string, engine default: "")
#ARMA_CFG_SERVER_COMMAND_PASSWORD=
# maxPlayers  (number, engine default: 64)
#ARMA_CFG_MAX_PLAYERS=
# admins  (string list, engine default: {})
#ARMA_CFG_ADMINS=
# headlessClients  (string list, engine default: {})
#ARMA_CFG_HEADLESS_CLIENTS=
# localClient  (string list, engine default: {})
#ARMA_CFG_LOCAL_CLIENT=
# filePatchingExceptions  (string list, engine default: {})
#ARMA_CFG_FILE_PATCHING_EXCEPTIONS=
# loopback  (bool, engine default: false)
#ARMA_CFG_LOOPBACK=
# upnp  (bool, engine default: false)
#ARMA_CFG_UPNP=
# requiredBuild  (number, engine default: 0)
#ARMA_CFG_REQUIRED_BUILD=
# kickDuplicate  (flag, engine default: 0)
#ARMA_CFG_KICK_DUPLICATE=

# ---- MESSAGE OF THE DAY ----
# motd  (string list, engine default: {})
#ARMA_CFG_MOTD=
# motdInterval  (number, engine default: 5)
#ARMA_CFG_MOTD_INTERVAL=

# ---- SECURITY ----
# BattlEye  (flag, engine default: 1)
#ARMA_CFG_BATTLEYE=
# verifySignatures  (number, engine default: 2)
#ARMA_CFG_VERIFY_SIGNATURES=
# equalModRequired  (flag, engine default: 0)
#ARMA_CFG_EQUAL_MOD_REQUIRED=
# allowedFilePatching  (number, engine default: 0)
#ARMA_CFG_ALLOWED_FILE_PATCHING=
# allowedLoadFileExtensions  (string list, engine default: undefined (everything allowed))
#ARMA_CFG_ALLOWED_LOAD_FILE_EXTENSIONS=
# allowedPreprocessFileExtensions  (string list, engine default: undefined (everything allowed))
#ARMA_CFG_ALLOWED_PREPROCESS_FILE_EXTENSIONS=
# allowedHTMLLoadExtensions  (string list, engine default: undefined (everything allowed))
#ARMA_CFG_ALLOWED_HTML_LOAD_EXTENSIONS=
# allowedHTMLLoadURIs  (string list, engine default: undefined (everything allowed))
#ARMA_CFG_ALLOWED_HTML_LOAD_URIS=
# zeusCompositionScriptLevel  (number, engine default: 1)
#ARMA_CFG_ZEUS_COMPOSITION_SCRIPT_LEVEL=

# ---- VOTING ----
# voteThreshold  (number, engine default: 0.5)
#ARMA_CFG_VOTE_THRESHOLD=
# voteMissionPlayers  (number, engine default: 1)
#ARMA_CFG_VOTE_MISSION_PLAYERS=
# allowedVoteCmds  (rows, engine default: {})
#ARMA_CFG_ALLOWED_VOTE_CMDS=
# allowedVotedAdminCmds  (rows, engine default: {})
#ARMA_CFG_ALLOWED_VOTED_ADMIN_CMDS=

# ---- NETWORK QUALITY ----
# maxPing  (number, engine default: -1)
#ARMA_CFG_MAX_PING=
# maxPacketLoss  (number, engine default: -1)
#ARMA_CFG_MAX_PACKET_LOSS=
# maxDesync  (number, engine default: -1)
#ARMA_CFG_MAX_DESYNC=
# disconnectTimeout  (number, engine default: 15)
#ARMA_CFG_DISCONNECT_TIMEOUT=
# kickClientsOnSlowNetwork  (number list, engine default: { 1, 1, 1, 1 })
#ARMA_CFG_KICK_CLIENTS_ON_SLOW_NETWORK=
# enablePlayerDiag  (flag, engine default: 0)
#ARMA_CFG_ENABLE_PLAYER_DIAG=
# callExtReportLimit  (number, engine default: 1000)
#ARMA_CFG_CALL_EXT_REPORT_LIMIT=
# steamProtocolMaxDataSize  (number, engine default: 1024)
#ARMA_CFG_STEAM_PROTOCOL_MAX_DATA_SIZE=
# armaUnitsTimeout  (number, engine default: 30)
#ARMA_CFG_ARMA_UNITS_TIMEOUT=

# ---- KICKS AND TIMEOUTS ----
# kickTimeout  (rows, engine default: { { 0, 60 }, { 1, 60 }, { 2, 60 }, { 3, 60 } })
#ARMA_CFG_KICK_TIMEOUT=
# votingTimeOut  (timeout, engine default: 60 or { 60, 90 })
#ARMA_CFG_VOTING_TIME_OUT=
# roleTimeOut  (timeout, engine default: 90 or { 90, 120 })
#ARMA_CFG_ROLE_TIME_OUT=
# briefingTimeOut  (timeout, engine default: 60 or { 60, 90 })
#ARMA_CFG_BRIEFING_TIME_OUT=
# debriefingTimeOut  (timeout, engine default: 45 or { 45, 60 })
#ARMA_CFG_DEBRIEFING_TIME_OUT=
# lobbyIdleTimeout  (number, engine default: 0)
#ARMA_CFG_LOBBY_IDLE_TIMEOUT=

# ---- MISSION CYCLE ----
# missionsToServerRestart  (number, engine default: 0)
#ARMA_CFG_MISSIONS_TO_SERVER_RESTART=
# missionsToShutdown  (number, engine default: 0)
#ARMA_CFG_MISSIONS_TO_SHUTDOWN=
# autoSelectMission  (bool, engine default: false)
#ARMA_CFG_AUTO_SELECT_MISSION=
# randomMissionOrder  (bool, engine default: false)
#ARMA_CFG_RANDOM_MISSION_ORDER=
# persistent  (flag, engine default: 0)
#ARMA_CFG_PERSISTENT=
# forcedDifficulty  (string, engine default: "")
#ARMA_CFG_FORCED_DIFFICULTY=
# missionWhitelist  (string list, engine default: {})
#ARMA_CFG_MISSION_WHITELIST=
# missionHTTPDownloadBaseURL  (string, engine default: "")
#ARMA_CFG_MISSION_HTTP_DOWNLOAD_BASE_URL=

# ---- IN-GAME ----
# disableVoN  (flag, engine default: 0)
#ARMA_CFG_DISABLE_VON=
# vonCodec  (number, engine default: 1)
#ARMA_CFG_VON_CODEC=
# vonCodecQuality  (number, engine default: 3)
#ARMA_CFG_VON_CODEC_QUALITY=
# disableChannels  (rows, engine default: {})
#ARMA_CFG_DISABLE_CHANNELS=
# drawingInMap  (bool, engine default: true)
#ARMA_CFG_DRAWING_IN_MAP=
# skipLobby  (bool, engine default: false)
#ARMA_CFG_SKIP_LOBBY=
# allowProfileGlasses  (bool, engine default: true)
#ARMA_CFG_ALLOW_PROFILE_GLASSES=
# forceRotorLibSimulation  (number, engine default: 0)
#ARMA_CFG_FORCE_ROTOR_LIB_SIMULATION=
# overrideHazeQuality  (number, engine default: -1)
#ARMA_CFG_OVERRIDE_HAZE_QUALITY=
# idleFPSLimit  (number, engine default: 30)
#ARMA_CFG_IDLE_FPS_LIMIT=

# ---- LOGGING AND ANALYTICS ----
# logFile  (string, engine default: "")
#ARMA_CFG_LOG_FILE=
# timeStampFormat  (string, engine default: "short")
#ARMA_CFG_TIME_STAMP_FORMAT=
# timeStampFormatConsole  (string, engine default: "short")
#ARMA_CFG_TIME_STAMP_FORMAT_CONSOLE=
# statisticsEnabled  (flag, engine default: 1)
#ARMA_CFG_STATISTICS_ENABLED=

# ---- SERVER-SIDE SCRIPTING EVENT HANDLERS ----
# doubleIdDetected  (string, engine default: "")
#ARMA_CFG_DOUBLE_ID_DETECTED=
# onUserConnected  (string, engine default: "")
#ARMA_CFG_ON_USER_CONNECTED=
# onUserDisconnected  (string, engine default: "")
#ARMA_CFG_ON_USER_DISCONNECTED=
# onUserKicked  (string, engine default: "")
#ARMA_CFG_ON_USER_KICKED=
# onHackedData  (string, engine default: "")
#ARMA_CFG_ON_HACKED_DATA=
# onDifferentData  (string, engine default: "")
#ARMA_CFG_ON_DIFFERENT_DATA=
# onUnsignedData  (string, engine default: "")
#ARMA_CFG_ON_UNSIGNED_DATA=
# regularCheck  (string, engine default: "")
#ARMA_CFG_REGULAR_CHECK=

# ---- class AdvancedOptions ----
# logObjectNotFound  (flag, engine default: 1)
#ARMA_CFG_ADVANCED_OPTIONS_LOG_OBJECT_NOT_FOUND=
# skipDescriptionParsing  (flag, engine default: 0)
#ARMA_CFG_ADVANCED_OPTIONS_SKIP_DESCRIPTION_PARSING=
# ignoreMissionLoadErrors  (flag, engine default: 0)
#ARMA_CFG_ADVANCED_OPTIONS_IGNORE_MISSION_LOAD_ERRORS=
# queueSizeLogG  (number, engine default: 0)
#ARMA_CFG_ADVANCED_OPTIONS_QUEUE_SIZE_LOG_G=

# ---- class AntiFlood ----
# cycleTime  (number, engine default: 0.5)
#ARMA_CFG_ANTI_FLOOD_CYCLE_TIME=
# cycleLimit  (number, engine default: 400)
#ARMA_CFG_ANTI_FLOOD_CYCLE_LIMIT=
# cycleHardLimit  (number, engine default: 4000)
#ARMA_CFG_ANTI_FLOOD_CYCLE_HARD_LIMIT=
# enableKick  (flag, engine default: 0)
#ARMA_CFG_ANTI_FLOOD_ENABLE_KICK=

# ---- MISSIONS ----
# Indexed from 1, contiguous. TEMPLATE and DIFFICULTY are required per mission.
# PARAMS values are emitted as written: wrap in "..." for a string parameter.
#ARMA_CFG_MISSION_1_NAME=
#ARMA_CFG_MISSION_1_TEMPLATE=
#ARMA_CFG_MISSION_1_DIFFICULTY=
#ARMA_CFG_MISSION_1_PARAMS=

# ---- EXTRA ----
# Raw server.cfg text appended verbatim at the end of the generated file.
#ARMA_CFG_EXTRA=

# ---- DIFFICULTY OPTIONS (profile) ----
# reducedDamage  (number, values: 0 or 1)
#ARMA_DIFFICULTY_REDUCED_DAMAGE=
# groupIndicators  (number, values: 0 never, 1 limited distance, 2 always)
#ARMA_DIFFICULTY_GROUP_INDICATORS=
# friendlyTags  (number, values: 0 never, 1 limited distance, 2 always)
#ARMA_DIFFICULTY_FRIENDLY_TAGS=
# enemyTags  (number, values: 0 never, 1 limited distance, 2 always)
#ARMA_DIFFICULTY_ENEMY_TAGS=
# detectedMines  (number, values: 0 never, 1 limited distance, 2 always)
#ARMA_DIFFICULTY_DETECTED_MINES=
# commands  (number, values: 0 never, 1 fade out, 2 always)
#ARMA_DIFFICULTY_COMMANDS=
# waypoints  (number, values: 0 never, 1 fade out, 2 always)
#ARMA_DIFFICULTY_WAYPOINTS=
# tacticalPing  (number, values: 0 or 1 (unverified key))
#ARMA_DIFFICULTY_TACTICAL_PING=
# weaponInfo  (number, values: 0 never, 1 fade out, 2 always)
#ARMA_DIFFICULTY_WEAPON_INFO=
# stanceIndicator  (number, values: 0 never, 1 fade out, 2 always)
#ARMA_DIFFICULTY_STANCE_INDICATOR=
# staminaBar  (number, values: 0 or 1)
#ARMA_DIFFICULTY_STAMINA_BAR=
# weaponCrosshair  (number, values: 0 or 1)
#ARMA_DIFFICULTY_WEAPON_CROSSHAIR=
# visionAid  (number, values: 0 or 1)
#ARMA_DIFFICULTY_VISION_AID=
# thirdPersonView  (number, values: 0 off, 1 on, 2 vehicles only)
#ARMA_DIFFICULTY_THIRD_PERSON_VIEW=
# cameraShake  (number, values: 0 or 1)
#ARMA_DIFFICULTY_CAMERA_SHAKE=
# scoreTable  (number, values: 0 or 1)
#ARMA_DIFFICULTY_SCORE_TABLE=
# deathMessages  (number, values: 0 or 1)
#ARMA_DIFFICULTY_DEATH_MESSAGES=
# vonID  (number, values: 0 or 1)
#ARMA_DIFFICULTY_VON_ID=
# mapContent  (number, values: 0 or 1)
#ARMA_DIFFICULTY_MAP_CONTENT=
# mapContentFriendly  (number, values: 0 or 1 (unverified key))
#ARMA_DIFFICULTY_MAP_CONTENT_FRIENDLY=
# mapContentEnemy  (number, values: 0 or 1 (unverified key))
#ARMA_DIFFICULTY_MAP_CONTENT_ENEMY=
# mapContentMines  (number, values: 0 or 1 (unverified key))
#ARMA_DIFFICULTY_MAP_CONTENT_MINES=
# autoReport  (number, values: 0 or 1)
#ARMA_DIFFICULTY_AUTO_REPORT=
# multipleSaves  (number, values: 0 or 1)
#ARMA_DIFFICULTY_MULTIPLE_SAVES=

# ---- DIFFICULTY AI (profile) ----
# aiLevelPreset  (number, values: 0 low, 1 normal, 2 high, 3 custom)
#ARMA_DIFFICULTY_AI_LEVEL_PRESET=
# skillAI  (number, values: 0.0 to 1.0, used when preset is 3)
#ARMA_DIFFICULTY_AI_SKILL=
# precisionAI  (number, values: 0.0 to 1.0, used when preset is 3)
#ARMA_DIFFICULTY_AI_PRECISION=
